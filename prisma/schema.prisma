generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

model Client {
  id             String              @id @default(cuid())
  name           String
  email          String              @unique
  passwordHash   String
  image          String?
  role           Role                @default(MEMBER)
  isActive       Boolean             @default(true)

  // Portal SSO
  portalClientId String?             @unique // aiatende-portal Client.id — set for accounts provisioned via SSO
  ssoProvisioned Boolean             @default(false) // skips the phone/birthDate/address/consent profile-completion gate

  // Profile Fields
  fullName       String?
  phone          String?
  birthDate      DateTime?
  address        Json?               // { street, number, neighborhood, city, state, zip }
  termsAccepted  Boolean             @default(false)
  lgpdConsent    Boolean             @default(false)

  // Meta Integration
  metaUserAccessToken String?
  metaUserTokenExpiry DateTime?

  // Google Integration
  googleUserRefreshToken String?
  googleUserAccessToken  String?
  googleUserTokenExpiry  DateTime?

  // Relations
  metaAdAccounts  MetaAdAccount[]
  googleAdAccounts GoogleAdAccount[]
  integrations   IntegrationConfig[]
  
  // Sharing
  sentInvites     AccountInvite[]    @relation("SentInvites")
  receivedInvites AccountInvite[]    @relation("ReceivedInvites")

  // Goals
  goals           ClientGoal[]

  // Views
  tableViews      TableView[]

  // Lead tracking (site -> WhatsApp attribution)
  pixelSessions   PixelSession[]
  trackingLinks   TrackingLink[]
  trackedMessages TrackedMessage[]
  kommoFieldMapping KommoFieldMapping?
  mappedAds       MappedAd[]
  adMessageLinks  AdMessageLink[]
  journeyStages       JourneyStage[]
  leads               Lead[]
  conversionEventLogs ConversionEventLog[]

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model MetaAdAccount {
  id             String              @id @default(cuid())
  clientId       String
  client         Client              @relation(fields: [clientId], references: [id])
  adAccountId    String
  name           String?
  accessToken    String
  tokenExpiresAt DateTime?
  status         String
  insightsDaily  MetaAdInsightDaily[]

  // Conversions API — separate from accessToken above (a Marketing API read token, not
  // necessarily CAPI-scoped). No OAuth flow discovers these automatically; the client pastes
  // them from Meta's Events Manager. Used by the lead-journey conversion-event sender.
  pixelId         String?
  capiAccessToken String?

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([clientId])
  @@index([adAccountId])
}

model IntegrationConfig {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  provider    String   // "KOMMO"
  isActive    Boolean  @default(false)
  config      Json?    // { subdomain: "..." }
  journeyMap  Json?    // ["Criado", "Qualificado", ...]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
}

model MetaAdInsightDaily {
  id              String         @id @default(cuid())
  metaAdAccountId String
  metaAdAccount   MetaAdAccount  @relation(fields: [metaAdAccountId], references: [id])
  date            DateTime
  campaignId      String
  campaignName    String
  adsetId         String
  adsetName       String
  adId            String
  adName          String
  impressions     Int
  clicks          Int
  spend           Float
  leads           Int
  reach           Int            @default(0)
  results         Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([metaAdAccountId, adId, date])
  @@index([campaignId])
  @@index([adId])
  @@index([date])
}

model GoogleAdAccount {
  id             String                @id @default(cuid())
  clientId       String
  client         Client                @relation(fields: [clientId], references: [id])
  customerId     String                // Google Ads Customer ID (123-456-7890)
  managerId      String?               // MCC ID if applicable — passed as login_customer_id to the API
  name           String?
  refreshToken   String                // Critical for offline access
  accessToken    String?               // Short-lived
  tokenExpiresAt DateTime?
  status         String                @default("ACTIVE") // ACTIVE, DISCONNECTED
  insightsDaily  GoogleAdInsightDaily[]

  // Consent Mode signals sent with every offline conversion upload (ad_user_data/ad_personalization)
  // — Google requires these for EEA-region accounts; default true since most tenants aren't EEA.
  googleAdsConsentGranted Boolean @default(true)
  // Detected via `SELECT customer.currency_code FROM customer` during the ad-catalog sync — more
  // reliable than the client-entered KommoFieldMapping.defaultCurrency for what Google will accept.
  currencyCode            String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([clientId])
  @@index([customerId])
}

model GoogleAdInsightDaily {
  id                String          @id @default(cuid())
  googleAdAccountId String
  googleAdAccount   GoogleAdAccount @relation(fields: [googleAdAccountId], references: [id])
  date              DateTime
  campaignId        String
  campaignName      String
  adGroupId         String
  adGroupName       String
  adId              String
  adName            String
  impressions       Int
  clicks            Int
  cost              Float           // "spend" in Google Ads terms (micros usually, but storing as float here for consistency)
  conversions       Float           // "leads" or "results"
  conversionValue   Float?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([googleAdAccountId, adId, date])
  @@index([campaignId])
  @@index([adId])
  @@index([date])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model AccountInvite {
  id          String       @id @default(cuid())
  ownerId     String
  owner       Client       @relation("SentInvites", fields: [ownerId], references: [id])
  guestId     String
  guest       Client       @relation("ReceivedInvites", fields: [guestId], references: [id])
  status      InviteStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([ownerId, guestId]) // Prevent duplicate invites between same users
  @@index([ownerId])
  @@index([guestId])
}

enum GoalType {
  INVESTMENT
  ROAS
  CPA // Cost Per Action (Step)
}

model ClientGoal {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  type        GoalType
  stageIndex  Int?     // Only for CPA goals (0 = Stage 1, 1 = Stage 2, etc.)
  value       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clientId, type, stageIndex]) // Ensure one goal per type/stage per client
  @@index([clientId])
}

model TableView {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  name        String
  dataSource  String   // "KOMMO", "META", "HYBRID"
  columns     Json     // Array of column keys e.g. ["name", "status", "spend"]
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId, dataSource])
}

// ---------------------------------------------------------------------------
// Lead tracking (site -> WhatsApp attribution) — replaces Tintim. See plan doc
// "TrackFlow como rastreador de leads" for the full design/rationale.
// ---------------------------------------------------------------------------

// A browser session on the client's site, captured by the TrackFlow pixel. Holds the UTM/click
// params present when the visitor arrived, so they can be reattached to whatever WhatsApp
// conversation that visitor starts later. `sessionCode` (short, generated at capture time) is
// the actual value embedded into that visitor's WhatsApp message — NOT a per-button static
// code, since many different visitors (each with their own UTMs) click the same site button.
// The pixel script asks /api/public/pixel/wa-link for a ready-to-use wa.me href per click,
// which stitches this session's own code into the TrackingLink's message template.
model PixelSession {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  sessionCode String  @unique
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  fbclid      String?
  gclid       String?
  gbraid      String?
  wbraid      String?
  // Meta's browser-id cookie (_fbp) — not a click id, doesn't feed Kommo today, but Meta wants
  // it alongside fbc for Conversions API matching once that's built (see docs/future-considerations.md).
  fbp         String?
  landingUrl  String?

  // Set when a wa.me link is generated for this session — which button/template was used,
  // for reporting ("which button converts") and as the TIME_WINDOW fallback's best guess.
  lastTrackingLinkId String?
  lastTrackingLink   TrackingLink? @relation(fields: [lastTrackingLinkId], references: [id])

  createdAt DateTime  @default(now())
  matchedAt DateTime? // set once a TrackedMessage consumes this session

  @@index([clientId])
  @@index([createdAt])
}

enum CodingStrategy {
  INVISIBLE // zero-width chars encoding the visitor's PixelSession code, embedded in the text
  VISIBLE_CODE // short human-readable code appended to the text
  TIME_WINDOW // no code at all — matching relies purely on receive-time correlation
}

// A client-configured "WhatsApp button" for their site: which number it opens, the message
// template, and how the visitor's session code gets embedded into that message. Reusable
// across every visitor who clicks it — the actual code embedded differs per PixelSession.
model TrackingLink {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  label           String
  waNumber        String
  messageTemplate String
  codingStrategy  CodingStrategy @default(INVISIBLE)

  pixelSessions   PixelSession[]
  trackedMessages TrackedMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

enum MatchStrategy {
  CODE_INVISIBLE
  CODE_VISIBLE
  TIME_WINDOW
  AD_CODE // matched a static AdMessageLink.code — Fase 2, no PixelSession involved at all
  UNMATCHED
}

enum KommoSyncStatus {
  PENDING
  SYNCED
  FAILED
  SKIPPED // no match found, or Kommo not configured for this client
}

// Every inbound WhatsApp message relayed from the portal, stored unconditionally BEFORE any
// matching/Kommo-write is attempted — this table is the source of truth; the Kommo push is a
// best-effort projection on top of it, never the only copy (see plan doc).
model TrackedMessage {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  waId        String
  text         String
  receivedAt   DateTime

  matchStrategy        MatchStrategy @default(UNMATCHED)
  matchedPixelSessionId String?
  matchedTrackingLinkId String?
  matchedTrackingLink   TrackingLink? @relation(fields: [matchedTrackingLinkId], references: [id])
  // Set when matchStrategy is AD_CODE (Fase 2) — the ad this message matched directly, no
  // PixelSession involved. Mutually exclusive with matchedPixelSessionId in practice.
  matchedMappedAdId    String?
  matchedMappedAd      MappedAd? @relation(fields: [matchedMappedAdId], references: [id])

  kommoLeadId     String?
  kommoSyncStatus KommoSyncStatus @default(PENDING)
  kommoSyncedAt   DateTime?
  kommoSyncError  String?

  // How the resolved MappedAd (if any) was found — "id" (reliable, dynamic UTM token) vs "name"
  // (fallback match against MappedAd.name, lower confidence) vs null (no ad-catalog match at
  // all). Audit-only — doesn't change what's written to Kommo, see lib/adCatalogMatch.ts.
  resolvedAdMatchConfidence String?

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([waId])
  @@index([receivedAt])
  @@index([matchedPixelSessionId])
}

// Per-client mapping of UTM/click-id fields to that client's Kommo custom-field IDs (IDs are
// per-Kommo-account, never portable across clients — resolved once here instead of live on
// every write). Filled in by the client on a small settings screen.
model KommoFieldMapping {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id])

  utmSourceFieldId   Int?
  utmMediumFieldId   Int?
  utmCampaignFieldId Int?
  utmContentFieldId  Int?
  utmTermFieldId     Int?
  fbclidFieldId      Int?
  gclidFieldId       Int?
  gbraidFieldId      Int?
  wbraidFieldId      Int?

  // Resolved catalog IDs (see MappedAd) — separate fields from the raw UTM text above, so the
  // client can see both what was captured and what it resolved to.
  campaignIdFieldId Int?
  adsetIdFieldId    Int?
  adIdFieldId       Int?

  // Kommo has no per-lead currency field (Lead.price is a bare number) — used as the
  // currency_code/currency sent alongside Purchase-type conversion events (see leadJourney.ts).
  defaultCurrency String @default("BRL")

  updatedAt DateTime @updatedAt
}

enum AdPlatform {
  META
  GOOGLE
}

// Current campaign/adset/ad structure for a client's connected ad accounts — a catalog, not a
// time series (that's *AdInsightDaily). Synced manually or by cron (lib/adCatalogSync.ts); no
// webhook exists on either platform for structural changes, so this is poll-based by design.
// Flattened at ad level (the unit the client cares about) with campaign/adset denormalized onto
// each row, so resolving a UTM captured at any granularity never needs a recursive join.
model MappedAd {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  platform AdPlatform

  adExternalId String
  adName       String
  adStatus     String // raw status string from the platform

  // Meta ad account this ad belongs to (bare digits, no `act_` — matches MetaAdAccount.adAccountId).
  // Null for Google rows. Denormalized here (not looked up from the client's "active" account at
  // link-build time) so a Meta Ads Manager deep link stays correct even if the client later
  // reconnects a different ad account — this ad's own row still points at the right one.
  adAccountId String?

  campaignExternalId String
  campaignName       String

  adsetExternalId String // "ad set" on Meta, "ad group" on Google — unified name here
  adsetName       String

  lastSyncedAt DateTime  @default(now())
  // Soft-delete marker — set when a sync no longer sees this adExternalId in the platform's
  // account. Never deleted for real: past leads may still reference it via resolvedAdMatchConfidence,
  // and the ad can reappear (cleared back to null) if it's ever un-archived.
  removedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Fase 2: static Click-to-WhatsApp tracked message for this ad (Meta only).
  adMessageLink   AdMessageLink?
  trackedMessages TrackedMessage[]
  leads           Lead[]

  @@unique([clientId, platform, adExternalId])
  @@index([clientId, platform])
  @@index([clientId, platform, campaignExternalId])
}

// Fase 2 ("anúncio → WhatsApp direto"): a static Click-to-WhatsApp tracked message, one per ad.
// Unlike PixelSession (a fresh code per site visitor), a CTWA ad's pre-filled message is
// configured once in Meta Ads Manager and is identical for everyone who clicks it — so the code
// has to be static per ad, not generated per click. See docs/future-considerations.md for why
// this stays a manual copy/paste step instead of writing the ad's message via the Marketing API.
model AdMessageLink {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  mappedAdId String   @unique
  mappedAd   MappedAd @relation(fields: [mappedAdId], references: [id])

  code            String         @unique // static code for this ad, forever (until regenerated)
  waNumber        String
  messageTemplate String
  codingStrategy  CodingStrategy // only INVISIBLE | VISIBLE_CODE apply — no TIME_WINDOW fallback
                                 // exists for a CTWA click (there's no "recent site visit" signal)
  finalMessage    String         // messageTemplate + embedded code, ready to paste into Meta Ads Manager

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

// Lead journey: a client-configured funnel stage, tied to a real Kommo pipeline+status (fetched
// live via kommo.pipelines.list()/listStatuses() — replaces the old free-text journeyMap strings
// as the source of truth). Moving a lead into this stage fires the configured event(s).
model JourneyStage {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  label String // display label ("Lead criado", "Agendado", ...)
  order Int    // funnel position

  // 'FIRST' | 'LAST' | null (middle) — every journey always has exactly one FIRST ("Lead criado")
  // and one LAST ("Compra"); only their Kommo pipeline/status mapping is configurable, they can't
  // be deleted/reordered away from the bookend position. Middle stages (null) are freely added/
  // removed/reordered between them.
  position String?

  kommoPipelineId Int
  kommoStatusId   Int

  // Meta: a standard CAPI event name (Lead/Schedule/InitiateCheckout/Purchase/...) or a custom one
  metaEventName String?

  // Google: which existing Conversion Action (created by the client in Google Ads) fires here
  googleConversionActionId String?

  leads               Lead[]
  conversionEventLogs ConversionEventLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, kommoPipelineId, kommoStatusId])
  @@index([clientId])
}

// A lead TrackFlow knows about, mirrored from Kommo — created/updated by processLeadStageChange
// (lib/leadJourney.ts) the first time a kommoLeadId is seen (or while waId is still unknown).
// Kommo stays the system of record; this only needs to know the lead's current stage and what's
// already been fired, plus enough attribution to build a conversion event.
model Lead {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  kommoLeadId Int
  waId        String? // normalized phone, read from the lead's main Kommo contact

  // Attribution — read back from the lead's own Kommo custom fields (the same fieldIds
  // KommoFieldMapping already uses to write them), not a new join through PixelSession/TrackedMessage.
  fbclid String?
  gclid  String?
  gbraid String?
  wbraid String?

  // Match-quality data for Meta CAPI / Google Enhanced Conversions for Leads — all read from
  // built-in Kommo fields (Contact.first_name/last_name, Contact's EMAIL/WORK custom field,
  // Lead.price), not fields the client has to map themselves.
  email     String?
  firstName String?
  lastName  String?
  saleValue Float? // Kommo Lead.price at the time this stage was reached

  matchedMappedAdId String?
  matchedMappedAd   MappedAd? @relation(fields: [matchedMappedAdId], references: [id])

  currentJourneyStageId String?
  currentJourneyStage   JourneyStage? @relation(fields: [currentJourneyStageId], references: [id])

  conversionEventLogs ConversionEventLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, kommoLeadId])
  @@index([clientId])
}

// One row per (lead, stage, platform) — ever. The unique constraint is the idempotency guard:
// Kommo can redeliver the same webhook, and a lead can be reprocessed manually without re-firing
// the same conversion event twice. PENDING rows are attempted inline; conversionEventRetryJob
// (cron, see instrumentation.ts) sweeps up PENDING/FAILED rows left behind by a failed attempt.
model ConversionEventLog {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id])
  journeyStageId String
  journeyStage   JourneyStage @relation(fields: [journeyStageId], references: [id])

  platform     AdPlatform // reuses the existing META | GOOGLE enum from the ad catalog
  eventName    String
  status       String    @default("PENDING") // PENDING | SENT | FAILED
  errorMessage String?
  sentAt       DateTime?
  attempts     Int       @default(0)

  createdAt DateTime @default(now())

  @@unique([leadId, journeyStageId, platform])
  @@index([clientId])
  @@index([status])
}
