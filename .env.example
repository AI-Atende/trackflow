# ==========================================
# Database
# ==========================================
DATABASE_URL=postgresql://user:password@localhost:5432/trackflow
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=trackflow

# ==========================================
# NextAuth
# ==========================================
NEXTAUTH_SECRET=seu_nextauth_secret_aqui
NEXTAUTH_URL=http://localhost:3000

# ==========================================
# Portal SSO bridge
# ==========================================
# Segredo compartilhado com o aiatende-portal (mesmo valor nos dois apps) — usado para
# validar o token de login assinado pelo portal em /api/integrations/trackflow/launch.
TRACKFLOW_SSO_SECRET=seu_segredo_sso_trackflow_aqui

# Chave compartilhada com o aiatende-portal (mesmo valor nos dois apps) — autentica as
# chamadas server-to-server do portal em /api/internal/clients/status (ativar/desativar) e
# /api/internal/messages/received (repasse de mensagens pro rastreamento de leads).
TRACKFLOW_API_KEY=sua_chave_interna_trackflow_aqui

# ==========================================
# Kommo (via tokens.aiatende.dev.br)
# ==========================================
# Mesmo valor do APP_API_KEY do aiatende-portal — é a chave global que o serviço de tokens
# aceita de qualquer chamador confiável, usada pra buscar o access token do Kommo e escrever
# os dados de rastreamento no lead (lib/kommo-auth.ts).
AIATENDE_API_KEY=sua_chave_do_tokens_service_aqui

# ==========================================
# Meta Ads
# ==========================================
META_APP_ID=
META_APP_SECRET=
NEXT_PUBLIC_META_APP_ID=

# ==========================================
# Google Ads
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DEVELOPER_TOKEN=

# ==========================================
# Internal API key (service-to-service calls)
# ==========================================
API_KEY=
